# ============================================================
# SentinelOps — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---------------------- ML Service ----------------------
MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
MODEL_CACHE_DIR=/app/models
ML_SERVICE_PORT=8000
LOG_LEVEL=INFO

# ---------------------- Auth Service ----------------------
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string
MONGO_URI=mongodb://mongo:27017/sentinelops
AUTH_SERVICE_PORT=3001

# ---------------------- MongoDB ----------------------
MONGO_INITDB_DATABASE=sentinelops

# ---------------------- Grafana ----------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=sentinelops-grafana

# ---------------------- Docker Registry ----------------------
DOCKER_REGISTRY=docker.io/sentinelops
IMAGE_TAG=latest

# ---------------------- AWS (for Terraform / Jenkins) ----------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
